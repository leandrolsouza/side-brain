{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist/main",
    "rootDir": "src",
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*"
  ]
}