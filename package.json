{
  "name": "sidebrain",
  "version": "0.3.0",
  "description": "Organize your work life with AI-powered note categorization",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "node scripts/wait-and-start.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron dist/main/main/index.js",
    "test": "npm run test:rebuild && vitest run --config vitest.config.main.ts",
    "test:watch": "npm run test:rebuild && vitest --config vitest.config.main.ts",
    "test:coverage": "npm run test:rebuild && vitest run --config vitest.config.main.ts --coverage",
    "test:rebuild": "npm rebuild better-sqlite3",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.23.0",
    "react-force-graph-2d": "^1.28.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.6",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "9.2.1",
    "electron": "35.0.0",
    "electron-builder": "26.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "8.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.sidebrain.app",
    "productName": "SideBrain",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "leandrolsouza",
      "repo": "my-agent"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}