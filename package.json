{
  "name": "sidebrain",
  "version": "0.9.0",
  "description": "Organize your work life with AI-powered note categorization",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "node scripts/wait-and-start.js",
    "postinstall": "npx install-electron && electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run rebuild:electron && electron dist/main/main/index.js",
    "test": "npm run test:rebuild && vitest run --config vitest.config.main.ts",
    "test:watch": "npm run test:rebuild && vitest --config vitest.config.main.ts",
    "test:coverage": "npm run test:rebuild && vitest run --config vitest.config.main.ts --coverage",
    "test:renderer": "vitest run --config vitest.config.renderer.ts",
    "test:renderer:watch": "vitest --config vitest.config.renderer.ts",
    "test:all": "npm run test && npm run test:renderer",
    "test:rebuild": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "check-i18n": "node scripts/check-i18n.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@electron/rebuild": "4.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "fast-check": "^4.9.0",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.sidebrain.app",
    "productName": "SideBrain",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "leandrolsouza",
      "repo": "my-agent"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}