{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "dist/renderer",
    "rootDir": "src",
    "sourceMap": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
